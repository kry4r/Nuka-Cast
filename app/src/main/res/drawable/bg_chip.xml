<?xml version="1.0" encoding="utf-8"?>
<!-- Episode and line chips: quiet when idle, clearly marked when focused or selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <!-- A dark fill with a bright border, not a white fill: with a white fill the label came
                 out white-on-white and a focused chip looked like an empty box. -->
            <solid android:color="@color/surface_raised" />
            <stroke android:width="2dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/surface_soft" />
            <stroke android:width="1dp" android:color="@color/accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <solid android:color="@color/surface_soft" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
